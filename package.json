{
  "name": "ai-or-real-kiosk",
  "version": "1.1.0",
  "private": true,
  "description": "AI or Real \u2014 offline touchscreen game for portrait Windows kiosks",
  "author": "SurroundTouch",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "desktop": "npm run build && electron . --built",
    "desktop:dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dist:win": "npm run build && electron-builder --win --x64",
    "package:win": "npm run build && electron-builder --win --x64 --dir",
    "test:desktop": "node scripts/test-store.cjs && node scripts/test-content.cjs",
    "dist:win:zip": "npm run build && electron-builder --win zip --x64",
    "check:assets": "node scripts/check-assets.mjs",
    "desktop:preview": "npm run build && electron . --built --windowed",
    "desktop:review": "npm run build && electron . --built --windowed --review"
  },
  "dependencies": {
    "@fontsource/noto-kufi-arabic": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "studio.surroundtouch.aiorreal",
    "productName": "AI or Real",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "AI-or-Real-${version}-setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "AI-or-Real-${version}-portable-${arch}.${ext}"
    },
    "artifactName": "AI-or-Real-${version}-windows-${arch}.${ext}",
    "extraFiles": [
      {
        "from": "WINDOWS-START.txt",
        "to": "START-HERE.txt"
      },
      {
        "from": "Review-AI-or-Real.cmd",
        "to": "Review-AI-or-Real.cmd"
      },
      {
        "from": "src/keyboard/fonts/OFL.txt",
        "to": "licenses/Noto-Kufi-Arabic-OFL.txt"
      }
    ]
  },
  "type": "module"
}
